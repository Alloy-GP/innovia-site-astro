---
// Static route: /members/profile/
// Member Profile Intake — Part 1 of member onboarding. A self-saving intake form
// a new member firm fills in (~10 min); it feeds the member highlight page.
//
// Uses the global BaseLayout chrome (shared SiteHeader + SiteFooter, dark 'inverse'
// header). NOT linked from site nav/menus. noindex — internal onboarding form.
import BaseLayout from "../../layouts/BaseLayout.astro";
import MemberIntake from "../../components/MemberIntake.astro";
---
<BaseLayout
  title="Member Profile Intake · Innovia Co-op"
  description="Part 1 of your Innovia member onboarding — a 10-minute intake that builds your member highlight page."
  ogImage="/assets/og/option-1-type-led.png"
  robots="noindex, nofollow"
  headerVariant="inverse"
>
  <MemberIntake />
</BaseLayout>
