---
import BaseLayout from '../layouts/BaseLayout.astro';
import { eventSchema, breadcrumbSchema } from '../lib/schema.ts';
import { SITE } from '../config/site.ts';

const summitEvent = eventSchema({
  name: 'Innovia Summit 2027 — Benchmarks & Beyond',
  description:
    'The Innovia Co-op Annual Summit. Member-only working sessions on operating benchmarks, margin math, and the future of independent community association management. Two-hour peer breakouts, cohorts of 10-12, and the Day 2 Benchmark Reveal.',
  url: SITE.url + '/summit/',
  startDate: '2027-02-09',
  endDate: '2027-02-13',
  image: '/assets/og/option-1-type-led.png',
  locationName: 'The Tampa EDITION',
  streetAddress: '500 Channelside Dr',
  addressLocality: 'Tampa',
  addressRegion: 'FL',
  postalCode: '33602',
  audience: 'Innovia Co-op member companies',
});

const breadcrumb = breadcrumbSchema([
  { name: 'Home', url: SITE.url + '/' },
  { name: 'Summit 2027', url: SITE.url + '/summit/' },
]);

const html = `<style>
    /* ============================================================
       Summit 2027 — warm, art-deco, Florida-coded.
       Keeps Innovia navy as the spine; introduces sun-amber and
       coral as event-specific accents only. Venue is public as of the
       2027 reveal; registration runs through the member portal.
       ============================================================ */

    :root {
      --sun-amber:   #F4B25A;
      --sun-amber-d: #C68A39;
      --sun-coral:   #E87D6E;
      --sun-peach:   #F4D2A3;
      --sun-cream:   #F8ECD4;
      --night-deep:  #0A1936;
      --night-indigo:#1E2A4F;
    }

    body {
      background: var(--night-deep);
      color: rgba(255,255,255,0.78);
    }

    /* Solid navy nav (matches other pages) — beats the global .site-header.inverse transparent rule */
    .site-header, .site-header.inverse {
      background: rgba(15,36,71,0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.10);
    }
    .site-header nav > a { color: rgba(255,255,255,0.7); }
    .site-header nav > a:hover, .site-header nav > a.active { color: #fff; }
    .site-header .btn-navy { background: var(--sun-amber); color: var(--night-deep); }
    .site-header .btn-navy:hover { background: var(--sun-cream); }

    /* ===== HERO — sunset stage with art-deco curves ===== */
    .teaser-hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 40px 0 96px;
      min-height: 92vh;
      display: flex;
      flex-direction: column;
    }
    /* Painted sky: night → indigo → coral → amber from top to bottom */
    .teaser-hero::before {
      content: ""; position: absolute; inset: 0; z-index: -3;
      background:
        radial-gradient(ellipse 80% 60% at 78% 88%, rgba(244,178,90,0.85) 0%, rgba(244,178,90,0) 60%),
        radial-gradient(ellipse 100% 60% at 50% 100%, rgba(232,125,110,0.7) 0%, rgba(232,125,110,0) 70%),
        linear-gradient(180deg, var(--night-deep) 0%, var(--night-indigo) 38%, #4A3360 62%, #A14E5C 82%, var(--sun-coral) 96%);
    }
    /* Subtle vignette so navigation chrome reads */
    .teaser-hero::after {
      content: ""; position: absolute; inset: 0; z-index: -1;
      background:
        linear-gradient(180deg, rgba(10,25,54,0.5) 0%, transparent 24%),
        radial-gradient(ellipse 70% 50% at 50% 0%, rgba(10,25,54,0.6) 0%, transparent 80%);
      pointer-events: none;
    }

    /* Art-deco concentric sun, anchored bottom-right */
    .teaser-hero .deco-sun {
      position: absolute;
      right: -180px; bottom: -200px;
      width: 720px; height: 720px;
      z-index: -2;
      opacity: 0.65;
      pointer-events: none;
    }
    /* Subtle palm silhouettes left edge */
    .teaser-hero .deco-palms {
      position: absolute;
      left: -40px; bottom: -10px;
      width: 320px; height: 360px;
      z-index: -2;
      opacity: 0.32;
      pointer-events: none;
    }

    /* Top stamp row */
    .teaser-hero .stamp-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 32px 0 24px;
      border-bottom: 1px solid rgba(255,255,255,0.16);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
    }
    .teaser-hero .stamp-row .left,
    .teaser-hero .stamp-row .right {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .teaser-hero .stamp-row .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--sun-amber);
      box-shadow: 0 0 14px rgba(244,178,90,0.8);
    }

    /* The mark */
    .teaser-hero .mark-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 80px 0 56px;
      position: relative;
    }
    .teaser-hero .pre {
      font-family: var(--font-body);
      font-style: italic;
      font-size: clamp(15px, 1.2vw, 18px);
      color: rgba(255,255,255,0.7);
      max-width: 36ch;
      margin: 0 0 28px;
      letter-spacing: 0.005em;
    }
    .teaser-hero .summit-mark {
      font-family: var(--font-summit);
      font-weight: 700;
      font-size: clamp(72px, 11vw, 196px);
      line-height: 0.86;
      letter-spacing: 0.02em;
      color: #fff;
      text-transform: uppercase;
      margin: 0;
    }
    .teaser-hero .summit-mark .yr {
      color: var(--sun-amber);
      display: inline-block;
      position: relative;
    }
    .teaser-hero .summit-mark .yr::after {
      content: "";
      position: absolute;
      left: 4%; right: 4%;
      bottom: 0.1em;
      height: 0.06em;
      background: linear-gradient(90deg, transparent, var(--sun-amber), transparent);
      opacity: 0.5;
    }

    .teaser-hero .theme-bar {
      margin-top: 36px;
      padding: 20px 0 0;
      border-top: 1px solid rgba(255,255,255,0.18);
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 64px;
      align-items: start;
    }
    .teaser-hero .theme-bar .label {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--sun-amber); letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .teaser-hero .theme-bar h2 {
      font-family: var(--font-display);
      font-weight: 700;
      color: #fff;
      font-size: clamp(22px, 2.4vw, 32px);
      letter-spacing: -0.015em;
      line-height: 1.18;
      margin: 8px 0 0;
      text-wrap: balance;
    }
    .teaser-hero .theme-bar h2 em {
      color: var(--sun-amber);
      font-style: normal;
    }
    .teaser-hero .theme-bar .strap {
      font-size: 17px;
      line-height: 1.6;
      color: rgba(255,255,255,0.82);
      max-width: 52ch;
      margin: 0;
    }

    /* Bottom row: dates · format · CTA */
    .teaser-hero .below {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto;
      gap: 40px;
      align-items: end;
      padding-top: 36px;
      margin-top: 56px;
      border-top: 1px solid rgba(255,255,255,0.18);
    }
    .teaser-hero .below .cell {
      display: flex; flex-direction: column; gap: 6px;
    }
    .teaser-hero .below .k {
      font-family: var(--font-mono); font-size: 11px;
      color: rgba(255,255,255,0.55);
      letter-spacing: 0.14em; text-transform: uppercase;
    }
    .teaser-hero .below .v {
      font-family: var(--font-display); font-weight: 700;
      font-size: clamp(18px, 1.6vw, 22px);
      color: #fff;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .teaser-hero .below .v small {
      display: block;
      font-family: var(--font-body); font-weight: 400;
      font-size: 13px;
      color: rgba(255,255,255,0.6);
      margin-top: 4px;
    }
    .teaser-hero .below .cta-cell .btn {
      padding: 16px 28px;
      font-size: 15px;
    }
    .teaser-hero .below .btn-amber {
      background: var(--sun-amber);
      color: var(--night-deep);
      border: 1px solid var(--sun-amber);
      box-shadow: 0 12px 32px -8px rgba(244,178,90,0.6);
    }
    .teaser-hero .below .btn-amber:hover {
      background: var(--sun-cream);
      border-color: var(--sun-cream);
    }

    /* ===== INTRIGUE — Venue reveal ===== */
    .intrigue {
      position: relative;
      background: var(--sun-cream);
      color: var(--night-deep);
      padding: 140px 0 160px;
      overflow: hidden;
    }
    .intrigue::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 80% at 100% 50%, rgba(232,125,110,0.18) 0%, transparent 70%),
        radial-gradient(ellipse 40% 60% at 0% 100%, rgba(244,178,90,0.18) 0%, transparent 70%);
      pointer-events: none;
    }
    .intrigue .layout {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 96px;
      align-items: start;
      position: relative;
    }
    .intrigue .eyebrow-w {
      display: flex; align-items: center; gap: 12px;
      font-family: var(--font-mono); font-size: 11px;
      color: var(--sun-amber-d); letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .intrigue .eyebrow-w .pill {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--night-deep);
      color: var(--sun-amber);
      letter-spacing: 0.16em;
      font-size: 10px;
    }
    .intrigue h2 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(38px, 4.4vw, 64px);
      color: var(--night-deep);
      letter-spacing: -0.024em;
      line-height: 1.05;
      margin: 22px 0 0;
      max-width: 16ch;
      text-wrap: balance;
    }
    .intrigue h2 em {
      color: var(--sun-coral);
      font-style: italic;
      font-weight: 400;
    }
    .intrigue .lede {
      font-family: var(--font-body);
      font-size: 18px;
      line-height: 1.62;
      color: var(--night-indigo);
      margin: 24px 0 0;
      max-width: 38ch;
    }
    .intrigue .lede::first-letter {
      font-family: var(--font-display); font-weight: 900;
      font-size: 64px; float: left;
      line-height: 0.85;
      margin: 6px 12px 0 0;
      color: var(--sun-coral);
    }

    .intrigue .clues {
      display: flex; flex-direction: column;
      gap: 0;
      border-top: 1px solid rgba(10,25,54,0.18);
    }
    .intrigue .clue {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid rgba(10,25,54,0.18);
      align-items: start;
    }
    .intrigue .clue .num {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--sun-amber-d);
      letter-spacing: 0.06em;
      padding-top: 6px;
    }
    .intrigue .clue h4 {
      font-family: var(--font-display); font-weight: 700;
      font-size: 22px;
      color: var(--night-deep);
      letter-spacing: -0.01em;
      margin: 0 0 6px;
      line-height: 1.25;
    }
    .intrigue .clue p {
      font-family: var(--font-body);
      font-size: 15px; line-height: 1.6;
      color: var(--night-indigo);
      margin: 0;
      max-width: 50ch;
    }
    .intrigue .clue p em {
      font-style: italic;
      color: var(--sun-coral);
    }

    .intrigue .seal {
      margin-top: 36px;
      display: inline-flex; align-items: center; gap: 14px;
      padding: 14px 18px;
      background: var(--night-deep);
      color: var(--sun-amber);
      font-family: var(--font-mono); font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase;
    }
    .intrigue .seal svg { width: 14px; height: 14px; }

    /* ===== THEME — Benchmarks & Beyond ===== */
    .theme-section {
      background: var(--night-deep);
      color: rgba(255,255,255,0.8);
      padding: 140px 0 160px;
      position: relative;
      overflow: hidden;
    }
    .theme-section::before {
      content: "";
      position: absolute; inset: 0;
      background:
        radial-gradient(circle at 92% 12%, rgba(244,178,90,0.16) 0%, transparent 36%),
        radial-gradient(circle at 8% 88%, rgba(232,125,110,0.14) 0%, transparent 40%);
      pointer-events: none;
    }
    .theme-section .head {
      max-width: 1000px;
      margin: 0 auto 80px;
      text-align: center;
      position: relative;
    }
    .theme-section .head .label {
      display: inline-block;
      padding: 6px 14px;
      background: rgba(244,178,90,0.16);
      color: var(--sun-amber);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }
    .theme-section h2 {
      font-family: var(--font-display);
      font-weight: 700;
      color: #fff;
      font-size: clamp(38px, 5.4vw, 78px);
      letter-spacing: -0.026em;
      line-height: 1;
      margin: 0;
      text-wrap: balance;
    }
    .theme-section h2 em {
      color: var(--sun-amber);
      font-style: italic;
      font-weight: 400;
    }
    .theme-section .sub {
      font-family: var(--font-body);
      font-size: 19px;
      line-height: 1.6;
      max-width: 56ch;
      margin: 28px auto 0;
      color: rgba(255,255,255,0.78);
    }
    .theme-section .pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      margin-top: 80px;
      border-top: 1px solid rgba(255,255,255,0.18);
      border-bottom: 1px solid rgba(255,255,255,0.18);
      position: relative;
    }
    .theme-section .pillar {
      padding: 48px 36px;
      border-right: 1px solid rgba(255,255,255,0.18);
      display: flex; flex-direction: column;
      gap: 14px;
    }
    .theme-section .pillar:last-child { border-right: 0; }
    .theme-section .pillar .ix {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--sun-amber); letter-spacing: 0.06em;
    }
    .theme-section .pillar h3 {
      font-family: var(--font-display); font-weight: 700;
      font-size: 26px; color: #fff;
      letter-spacing: -0.014em; line-height: 1.2;
      margin: 0;
    }
    .theme-section .pillar p {
      font-size: 15px; line-height: 1.6;
      color: rgba(255,255,255,0.7);
      margin: 0;
    }
    .theme-section .pillar .quiet {
      font-family: var(--font-mono); font-size: 11px;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.04em;
      margin-top: auto; padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.10);
    }

    /* ===== PAST SUMMITS — archive + highlights ===== */
    .past {
      background: #FBFAF6;
      color: var(--fg-2);
      padding: 140px 0;
    }
    .past .head {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 64px;
      align-items: end;
      margin-bottom: 64px;
    }
    .past .head h2 {
      font-family: var(--font-display); font-weight: 700;
      color: var(--innovia-navy);
      font-size: clamp(36px, 4.4vw, 60px);
      letter-spacing: -0.024em;
      line-height: 1.04;
      max-width: 14ch;
      margin: 14px 0 0;
    }
    .past .head p {
      font-size: 17px;
      line-height: 1.62;
      color: var(--fg-2);
      max-width: 52ch;
      margin: 0;
    }

    .past .featured {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 0;
      margin-bottom: 24px;
      border: 1px solid var(--border-subtle);
      background: #fff;
      overflow: hidden;
    }
    .past .featured .photo {
      position: relative;
      min-height: 460px;
      overflow: hidden;
    }
    .past .featured .photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      filter: saturate(0.95);
    }
    .past .featured .photo .stamp {
      position: absolute;
      top: 24px; left: 24px;
      padding: 8px 14px;
      background: rgba(10,25,54,0.92);
      color: #fff;
      font-family: var(--font-mono); font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase;
    }
    .past .featured .photo .stamp .dot {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--sun-amber);
      margin-right: 10px;
      vertical-align: middle;
    }
    .past .featured .body {
      padding: 48px;
      display: flex; flex-direction: column;
      gap: 18px;
    }
    .past .featured .ix {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--innovia-green-deep); letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .past .featured h3 {
      font-family: var(--font-display); font-weight: 700;
      font-size: 32px;
      color: var(--innovia-navy);
      letter-spacing: -0.018em;
      line-height: 1.15;
      margin: 0;
    }
    .past .featured p {
      font-size: 15px; line-height: 1.6;
      color: var(--fg-2);
      margin: 0;
    }
    .past .featured .stats {
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      gap: 0;
      margin-top: 8px;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
    }
    .past .featured .stats > div {
      padding-right: 16px;
      border-right: 1px solid var(--border-subtle);
      display: flex; flex-direction: column; gap: 4px;
    }
    .past .featured .stats > div:last-child { border-right: 0; }
    .past .featured .stats .k {
      font-family: var(--font-mono); font-size: 10px;
      color: var(--fg-3);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .past .featured .stats .v {
      font-family: var(--font-display); font-weight: 800;
      font-size: 26px;
      color: var(--innovia-navy);
      letter-spacing: -0.014em;
      line-height: 1;
    }
    .past .featured .actions {
      margin-top: auto;
      display: flex; flex-wrap: wrap; gap: 12px;
    }

    /* Older editions row */
    .past .archive-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 24px;
    }
    .past .edition {
      background: #fff;
      border: 1px solid var(--border-subtle);
      padding: 28px;
      display: flex; flex-direction: column; gap: 14px;
      color: inherit;
    }
    .past .edition .yr {
      font-family: var(--font-summit); font-weight: 700;
      font-size: 56px;
      color: var(--innovia-navy);
      line-height: 0.9;
      letter-spacing: 0.02em;
    }
    .past .edition .v {
      font-family: var(--font-display); font-weight: 600;
      font-size: 17px;
      color: var(--innovia-navy);
      letter-spacing: -0.005em;
    }
    .past .edition .m {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--fg-3); letter-spacing: 0.04em;
    }
    .past .edition .hl {
      font-size: 14px; line-height: 1.55;
      color: var(--fg-2);
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid var(--border-subtle);
    }

    .past .external-link {
      margin-top: 36px;
      padding: 24px 28px;
      background: var(--innovia-navy);
      color: rgba(255,255,255,0.85);
      display: flex; justify-content: space-between; align-items: center;
      gap: 24px; flex-wrap: wrap;
    }
    .past .external-link h5 {
      font-family: var(--font-display); font-weight: 700;
      color: #fff;
      font-size: 19px;
      letter-spacing: -0.005em;
      margin: 0 0 4px;
    }
    .past .external-link p {
      font-size: 14px;
      color: rgba(255,255,255,0.7);
      margin: 0;
    }
    .past .external-link .url {
      font-family: var(--font-mono);
      color: var(--innovia-green);
    }
    .past .external-link a.btn {
      background: var(--innovia-green);
      color: var(--innovia-navy);
      padding: 14px 22px;
      font-size: 14px;
    }
    .past .external-link a.btn:hover { background: #fff; }

    /* ===== LOGISTICS — format, room block, cost, registration ===== */
    .logistics {
      background: var(--sun-cream);
      color: var(--night-deep);
      padding: 130px 0 140px;
      position: relative;
      overflow: hidden;
    }
    .logistics::before {
      content: "";
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 50% 70% at 0% 30%, rgba(244,178,90,0.20) 0%, transparent 70%),
        radial-gradient(ellipse 50% 70% at 100% 90%, rgba(232,125,110,0.16) 0%, transparent 70%);
      pointer-events: none;
    }
    .logistics .head {
      position: relative;
      max-width: 62ch;
      margin: 0 0 64px;
    }
    .logistics .head .label {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--sun-amber-d); letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .logistics .head h2 {
      font-family: var(--font-display); font-weight: 700;
      font-size: clamp(36px, 4.2vw, 60px);
      color: var(--night-deep);
      letter-spacing: -0.024em;
      line-height: 1.05;
      margin: 18px 0 0;
      text-wrap: balance;
    }
    .logistics .head h2 em {
      color: var(--sun-coral);
      font-style: italic;
      font-weight: 400;
    }
    .logistics .head p {
      font-family: var(--font-body);
      font-size: 18px; line-height: 1.62;
