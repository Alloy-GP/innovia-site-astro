    </div>
  </section>

  <!-- ============== NOTIFY ============== -->
  <section class="notify" id="register">
    <span id="notify" aria-hidden="true"></span>
    <div class="container">
      <div class="frame">
        <div class="copy">
          <span class="label">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Registration open
          </span>
          <h2>Register for <em>Summit 2027</em>.</h2>
          <p class="strap">Attendance is member-only. Registration and room booking both run through the member portal &mdash; sign in with your member company credentials to claim your passes and reserve a room in the Innovia block before it releases on January 15.</p>
        </div>

        <div class="reg-card">
          <div class="step">
            <span class="n">01</span>
            <div>
              <h4>Sign in to the member portal.</h4>
              <p>Use your member company credentials. If you don&rsquo;t have access yet, your company&rsquo;s primary contact can add you.</p>
            </div>
          </div>
          <div class="step">
            <span class="n">02</span>
            <div>
              <h4>Claim your passes.</h4>
              <p>Stockholder members have two complimentary passes; Participating members have one. There is no cost to attend.</p>
            </div>
          </div>
          <div class="step">
            <span class="n">03</span>
            <div>
              <h4>Book your room in the block.</h4>
              <p>The Tampa EDITION, $479 / night, February 9&ndash;13. The booking link is in the portal alongside your registration.</p>
            </div>
          </div>

          <div class="actions">
            <a href="https://community.innoviaco-op.com/" class="btn btn-amber" target="_blank" rel="noopener noreferrer">
              Sign In &amp; Register
              <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </a>
            <a href="/for-cams/why-innovia/#talk" class="btn btn-ghost">
              Not a member yet? Start here
              <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </a>
          </div>

          <p class="fine">Members only &middot; by invitation through a member company &middot; room block closes January 15, 2027</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== FOOTER ============== -->
  <!-- FOOTER -->
  


  
