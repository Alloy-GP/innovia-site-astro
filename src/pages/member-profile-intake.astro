---
// Static route: /member-profile-intake/
// Member Profile Intake — Part 1 of member onboarding. A self-saving intake form
// a new member firm fills in (~10 min); it feeds the member highlight page.
//
// Standalone page on purpose: it ships its OWN chrome (logo-only header + the
// Innovia×Alloy co-brand footer, inside MemberIntake.astro) — no site nav, and
// nothing links off this page. noindex — internal onboarding form.
import MemberIntake from "../components/MemberIntake.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Member Profile Intake · Innovia Co-op</title>
    <meta
      name="description"
      content="Part 1 of your Innovia member onboarding — a 10-minute intake that builds your member highlight page."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/assets/innovia-icon.png" />
    <link rel="apple-touch-icon" href="/assets/innovia-icon.png" />
  </head>
  <body data-screen-label="Member Profile Intake">
    <MemberIntake />
  </body>
</html>
