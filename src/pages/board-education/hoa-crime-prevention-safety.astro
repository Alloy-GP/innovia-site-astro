<BaseLayout
  title="8 Strategies to Prevent Crime in Your Community · HOA Guide | Innovia"
  description="Eight practical crime-prevention strategies for HOA and condo boards — lighting, sightlines, access control, package theft, cameras, vendor vetting, and reporting."
  ogImage="/assets/og/option-1-type-led.png"
  ctaLabel="Send Inquiry"
  ctaHref="/find-a-management-company/#request"
>
  <Fragment set:html={html} />
</BaseLayout>
