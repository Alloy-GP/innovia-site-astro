      { "@type": "ListItem", "position": 3, "name": "HOA Developer Transition", "item": "https://innoviaco-op.com/board-education/hoa-transition-from-developer/" }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "The Developer Turnover Process: A Step-by-Step Playbook for New HOA Boards",
    "description": "The sequence a newly-elected homeowner board should follow to take control of an HOA cleanly at developer turnover, from confirming the turnover trigger through preserving construction-defect claims.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Confirm the turnover trigger and timeline", "text": "Verify against your state's law and governing documents exactly when control passes and what rights homeowners have at each threshold, which sets every deadline that follows." },
      { "@type": "HowToStep", "position": 2, "name": "Hold the turnover meeting and elect the first homeowner-controlled board", "text": "At the turnover meeting, homeowners formally take a board majority. Follow the governing documents' notice and election rules precisely and record the meeting carefully." },
      { "@type": "HowToStep", "position": 3, "name": "Recover the association's records from the developer", "text": "Collect governing documents, financials, bank and reserve accounts, vendor contracts, warranties, permits, as-built plans, insurance policies, and all keys and access, and document what is received and outstanding." },
      { "@type": "HowToStep", "position": 4, "name": "Commission the turnover (transition) study", "text": "Engage an independent engineer and reserve analyst to assess the developer-built components, their condition, any construction defects, and whether reserves were adequately funded." },
      { "@type": "HowToStep", "position": 5, "name": "Conduct the turnover audit", "text": "Have an independent CPA audit the accounts from the developer-control period to confirm dues were collected and spent properly and reserves were funded as required." },
      { "@type": "HowToStep", "position": 6, "name": "Review and renegotiate developer-signed vendor contracts", "text": "Review every agreement to identify which contracts the board can cancel, rebid, or renegotiate now that homeowners control the association." },
      { "@type": "HowToStep", "position": 7, "name": "Establish reserves and the association's first independent budget", "text": "Use the transition study's findings to set the first homeowner-controlled budget and fund reserves for the repairs and replacements ahead." },
      { "@type": "HowToStep", "position": 8, "name": "Preserve construction-defect and warranty claims before the deadlines", "text": "If the study finds defects, act quickly. Statutes of limitation and repose are state-specific and can be short, so have your attorney identify every applicable deadline as soon as the study is complete." }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What triggers an HOA transition from the developer?", "acceptedAnswer": { "@type": "Answer", "text": "Turnover is typically triggered when the developer has sold a set percentage of the units or lots, or after a set number of years, whichever comes first. The exact threshold is set by your state's law and your community's governing documents, so the triggers vary widely. Check both your statute and your CC&Rs to find yours." } },
      { "@type": "Question", "name": "When should a new board start transition planning?", "acceptedAnswer": { "@type": "Answer", "text": "As early as possible, ideally before control formally passes from the developer. Starting early means your records, transition study, and turnover audit are lined up when the board takes over, rather than scrambling after the fact when deadlines are already running." } },
      { "@type": "Question", "name": "What is a turnover (transition) study, and is it required?", "acceptedAnswer": { "@type": "Answer", "text": "It is an independent engineering and financial review of the developer-built components and the association's reserves. Some states require or expect it and others do not, but even where optional it is strongly advised, because it is the board's window to document construction defects while claims are still viable. Skipping it is widely considered the most costly mistake a new board can make." } },
      { "@type": "Question", "name": "What is an HOA turnover audit?", "acceptedAnswer": { "@type": "Answer", "text": "A turnover audit is an independent financial audit of the accounts from the developer-control period, performed by a CPA. It confirms that dues were collected and spent properly and that reserves were funded as required before the board assumes responsibility. It is a financial check, distinct from the transition study's physical and engineering review." } },
      { "@type": "Question", "name": "What happens if the board skips the transition study?", "acceptedAnswer": { "@type": "Answer", "text": "The association can inherit undocumented construction defects, miss warranty and defect-claim deadlines, and discover underfunded reserves too late, often at a cost far exceeding the study itself. Because construction-defect deadlines are state-specific and can be short, a skipped study can permanently forfeit claims the association would otherwise have been able to bring." } }
    ]
  }
  </script>
`;
