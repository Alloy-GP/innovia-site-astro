<BaseLayout
  title="Why Join Innovia · The Cooperative Edge for Independent CAM Firms | Innovia Co-op"
  description="Independent CAM owners: see why 80+ firms joined Innovia — collective purchasing power, vetted vendor partnerships, peer community, and the edge to stay independent."
  ogImage="/assets/og/option-1-type-led.png"
  activeNav="cams"
  ctaLabel="Schedule a Conversation"
  ctaHref="#talk"
>
  <Fragment set:html={html} />
</BaseLayout>
