            <p>
              <strong>The Innovia Summit &middot; Members only</strong>
              The annual closed-door convening in Tampa, first week of February &mdash; open exclusively to Innovia members.
            </p>
            <a href="/summit/">
              See teaser
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <form id="wc-cam-connect" class="connect-form" data-endpoint="/api/lead" data-success="Thanks &mdash; we&rsquo;ll be in touch within 1&ndash;2 business days.">
          <div class="form-head">
            <span class="form-label">Member-company inquiry</span>
            <span class="form-count">10 fields &middot; ~3 min</span>
          </div>

          <fieldset>
            <legend>About you</legend>
            <div class="grid-2">
              <div class="fld">
                <input type="text" id="cf-first" name="firstName" placeholder=" " autocomplete="given-name" required>
                <label for="cf-first">First name<i class="rq">*</i></label>
              </div>
              <div class="fld">
                <input type="text" id="cf-last" name="lastName" placeholder=" " autocomplete="family-name" required>
                <label for="cf-last">Last name<i class="rq">*</i></label>
              </div>
            </div>
            <div class="grid-2">
              <div class="fld">
                <input type="email" id="cf-email" name="email" placeholder=" " autocomplete="email" required>
                <label for="cf-email">Work email<i class="rq">*</i></label>
              </div>
              <div class="fld">
                <input type="tel" id="cf-phone" name="phone" placeholder=" " autocomplete="tel">
                <label for="cf-phone">Phone</label>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>About your company</legend>
            <div class="grid-2">
              <div class="fld">
                <input type="text" id="cf-company" name="company" placeholder=" " autocomplete="organization" required>
                <label for="cf-company">Company name<i class="rq">*</i></label>
              </div>
              <div class="fld">
                <input type="text" id="cf-hq" name="hq" placeholder=" " autocomplete="address-level2" required>
                <label for="cf-hq">Headquartered<i class="rq">*</i></label>
              </div>
            </div>
            <div class="grid-2">
              <div class="fld fld-select">
                <select id="cf-portfolio" name="portfolio" required>
                  <option value="" selected hidden></option>
                  <option>Under 1,000</option>
                  <option>1,000&ndash;5,000</option>
                  <option>5,000&ndash;15,000</option>
                  <option>15,000&ndash;40,000</option>
                  <option>Over 40,000</option>
                </select>
                <label for="cf-portfolio">Portfolio size<i class="rq">*</i></label>
              </div>
              <div class="fld">
                <input type="text" id="cf-states" name="states" placeholder=" " required>
                <label for="cf-states">States we operate in<i class="rq">*</i></label>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>The conversation</legend>
            <div class="fld">
              <input type="text" id="cf-ref" name="referred_by" placeholder=" ">
              <label for="cf-ref">Were you referred by a member?</label>
            </div>
            <div class="fld fld-textarea">
              <textarea id="cf-goal" name="goal" rows="3" placeholder=" "></textarea>
              <label for="cf-goal">What&rsquo;s prompting the conversation?</label>
            </div>
          </fieldset>

          <div class="submit-row">
            <small>Confidential. Your details stay inside the cooperative office; we don&rsquo;t share with vendors or sell.</small>
            <button type="submit">
              Schedule a Conversation
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  


  
`;
