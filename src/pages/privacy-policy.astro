---
// Static route: /privacy-policy/
// Standard privacy policy. Uses the global BaseLayout (shared header/footer).
// Indexable. NOTE: review with legal counsel before relying on it.
import BaseLayout from '../layouts/BaseLayout.astro';

const updated = 'July 23, 2026';

const html = `<style>
    body { background: var(--innovia-navy); color: rgba(255,255,255,0.78); }

    .site-header { background: rgba(15,36,71,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.10); }
    .site-header nav > a { color: rgba(255,255,255,0.7); }
    .site-header nav > a:hover, .site-header nav > a.active { color: #fff; }
    .site-header .btn-navy { background: #fff; color: var(--innovia-navy); }
    .site-header .btn-navy:hover { background: var(--innovia-green); color: var(--innovia-navy); }
    .site-header .row { height: 76px; }

    .legal-hero { padding: 56px 0 24px; position: relative; overflow: hidden; }
    .legal-hero::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 92% 6%, rgba(149,208,49,0.13) 0%, transparent 42%); }
    .legal-hero .container { position: relative; z-index: 1; }
    .legal-hero .crumb { display: flex; gap: 10px; align-items: center; font-family: var(--font-mono); font-size: 12px; color: rgba(255,255,255,0.5); letter-spacing: 0.04em; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.18); margin-bottom: 34px; }
    .legal-hero .crumb a:hover { color: #fff; }
    .legal-hero h1 { font-family: var(--font-display); font-weight: 900; font-size: clamp(40px, 5vw, 68px); letter-spacing: -0.032em; color: #fff; line-height: 1; margin: 0; }
    .legal-hero .updated { font-family: var(--font-mono); font-size: 12px; color: rgba(255,255,255,0.5); letter-spacing: 0.04em; margin: 18px 0 0; }

    .legal-body { padding: 24px 0 96px; }
    .legal-body .prose { max-width: 74ch; }
    .legal-body h2 { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: #fff; letter-spacing: -0.014em; margin: 40px 0 12px; }
    .legal-body p, .legal-body li { font-size: 15px; line-height: 1.68; color: rgba(255,255,255,0.76); }
    .legal-body p { margin: 0 0 14px; }
    .legal-body ul { margin: 0 0 14px; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
    .legal-body a { color: var(--innovia-green); }
    .legal-body .note { font-size: 13px; color: rgba(255,255,255,0.5); border-left: 2px solid var(--innovia-green); padding: 4px 0 4px 16px; margin: 28px 0 0; }
  </style>

  <section class="legal-hero">
    <div class="container">
      <div class="crumb">
        <a href="/">Innovia</a><span>/</span>
        <span style="color:#fff;">Privacy Policy</span>
      </div>
      <h1>Privacy Policy</h1>
      <p class="updated">Last updated: ${updated}</p>
    </div>
  </section>

  <section class="legal-body">
    <div class="container">
      <div class="prose">
        <p>Innovia Co-op (&ldquo;Innovia,&rdquo; &ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;) respects your privacy. This policy explains what information we collect through innoviaco-op.com (the &ldquo;Site&rdquo;), how we use it, and the choices you have.</p>

        <h2>Information we collect</h2>
        <ul>
          <li><strong>Information you provide.</strong> When you submit a form &mdash; an inquiry, a request to connect, or a newsletter signup &mdash; we collect the details you enter, such as your name, email address, phone number, company, and any message you include.</li>
          <li><strong>Information collected automatically.</strong> Like most websites, we collect standard usage data (pages viewed, referring page, approximate location, browser and device type, and similar analytics) to understand how the Site is used and to improve performance.</li>
        </ul>

        <h2>How we use your information</h2>
        <ul>
          <li>To respond to your inquiry and follow up about the cooperative.</li>
          <li>To send the communications you request (for example, our newsletter), which you can unsubscribe from at any time.</li>
          <li>To operate, secure, measure, and improve the Site.</li>
        </ul>

        <h2>Cookies &amp; analytics</h2>
        <p>We use analytics to measure Site traffic and performance, which may include Google Analytics and Vercel Speed Insights. These tools may set cookies or collect usage data through your browser. You can control cookies through your browser settings; disabling them will not affect your ability to use the Site.</p>

        <h2>Email &amp; marketing</h2>
        <p>Transactional and notification emails (such as confirmations of a form you submitted) are sent using Resend. If you opt into our newsletter, your email is stored and managed in Mailchimp. Every marketing email includes an unsubscribe link, and you can opt out at any time.</p>

        <h2>Service providers</h2>
        <p>We share information only with the vendors that help us run the Site and communicate with you &mdash; currently our hosting provider (Vercel), our email provider (Resend), our email-marketing platform (Mailchimp), and our analytics provider (Google). These providers process data on our behalf and are not permitted to use it for their own purposes.</p>

        <h2>How we share information</h2>
        <p>We do <strong>not</strong> sell your personal information. We may disclose information if required by law, to protect our rights, or in connection with a business transfer. Otherwise, your details stay within the cooperative and the service providers listed above.</p>

        <h2>Data retention</h2>
        <p>We keep the information you provide for as long as needed to respond to you, provide the services you requested, and meet legal or operational requirements. You may request that we delete it (see below).</p>

        <h2>Your choices &amp; rights</h2>
        <p>Depending on where you live, you may have the right to access, correct, or delete the personal information we hold about you, and to opt out of marketing communications. To make a request, contact us using the details below and we will respond as required by applicable law.</p>

        <h2>Children&rsquo;s privacy</h2>
        <p>The Site is intended for a business audience and is not directed to children under 13. We do not knowingly collect personal information from children.</p>

        <h2>Changes to this policy</h2>
        <p>We may update this policy from time to time. When we do, we will revise the &ldquo;Last updated&rdquo; date above. Material changes will be reflected here on the Site.</p>

        <h2>Contact us</h2>
        <p>Questions about this policy or your information? Reach us through our <a href="/contact/">contact page</a>.</p>

        <p class="note">This policy is provided as a general template describing how the Site operates. Innovia should have it reviewed by legal counsel to confirm it meets applicable requirements (e.g. CCPA, GDPR) before relying on it.</p>
      </div>
    </div>
  </section>
`;
---
<BaseLayout
  title="Privacy Policy · Innovia Co-op"
  description="How Innovia Co-op collects, uses, and protects information submitted through innoviaco-op.com."
  ogImage="/assets/og/option-1-type-led.png"
  activeNav={null}
>
  <Fragment set:html={html} />
</BaseLayout>
