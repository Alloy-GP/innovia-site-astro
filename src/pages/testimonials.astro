---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/testimonials.css';
const html = `


  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <div class="crumb">
        <a href="/">Innovia</a>
        <span>/</span>
        <span style="color:#fff;">Testimonials</span>
        <div class="right">
          <span class="dot"></span>
          11&nbsp;members on the record &middot; filmed at Summit 2026
        </div>
      </div>

      <div class="title-row">
        <h1>
          What members <em>actually say</em> when the recorder is on.
        </h1>
        <div class="hero-stats">
          <div class="stat"><span class="v">11</span><span class="k">Members on the record</span></div>
          <div class="stat"><span class="v">28</span><span class="k">States represented</span></div>
          <div class="stat"><span class="v">8,000+</span><span class="k">HOAs managed</span></div>
          <div class="stat"><span class="v">1.4M+</span><span class="k">Homes served</span></div>
        </div>
      </div>

    </div>
  </section>

  <div class="filter-sticky">
    <div class="container">
      <div class="filter-band">
        <div class="row" data-filter-group="voice">
          <span class="label">Voice</span>
          <div class="pills">
            <button class="pill active" data-filter="all">All (16)</button>
            <button class="pill" data-filter="cam-owner">CAM owners (12)</button>
            <button class="pill" data-filter="senior-operator">Senior operators (4)</button>
          </div>
        </div>
        <div class="row" data-filter-group="topic">
          <span class="label">Topic</span>
          <div class="pills">
            <button class="pill active" data-filter="all">All</button>
            <button class="pill" data-filter="Joining Innovia">Joining Innovia</button>
            <button class="pill" data-filter="The peer council">The peer council</button>
            <button class="pill" data-filter="Business growth">Business growth</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TESTIMONIAL GRID -->
  <section class="listing">
    <div class="container">
      <div class="tcards">

        <article class="tcard" data-voice="cam-owner" data-topic="Joining Innovia">
          <span class="kind">Joining Innovia</span>
          <blockquote>CFM&rsquo;s goal is to remain independent and completely focused on the personal needs of each of our clients. To help us achieve this goal, we have invested in a Co-op membership with Innovia &mdash; which allows us to remain independent, while having buying power and thought leadership from other independent companies across the United States.</blockquote>
          <div class="attrib">
            <span class="initials">SD</span>
            <div class="who">
              <span class="name">Stacie Donnelly, PCAM, CCAM</span>
              <span class="firm">Condominium Financial Management, Inc.</span>
            </div>
          </div>
        </article>

        <article class="tcard video featured long" data-voice="cam-owner" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212073106" aria-label="Play video testimonial — Doug Newman, President" style="background: url('/assets/testimonials/1212073106.jpg') center / cover;">
            <span class="vbadge">Watch first</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">Featured &middot; The peer council</span>
          <blockquote>Knowing that you can reach out to a fellow member any day of the week, including weekends, and that they&rsquo;ll be there for you &mdash; in a true brotherly fashion &mdash; it&rsquo;s been astonishing.</blockquote>
          <div class="attrib">
            <span class="initials">DN</span>
            <div class="who">
              <span class="name">Doug Newman, President</span>
              <span class="firm">CPE Property Management Solutions &middot; New Haven, CT</span>
            </div>
          </div>
        </article>

        <article class="tcard video long" data-voice="cam-owner" data-topic="Business growth">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212073757" aria-label="Play video testimonial — Mark Jones, Owner" style="background: url('/assets/testimonials/1212073757.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">Business growth</span>
          <blockquote>Being a member brings a shared scale of resources that no independent management company could obtain on their own. Without Innovia, I couldn&rsquo;t be anywhere near as successful as I have been.</blockquote>
          <div class="attrib">
            <span class="initials">MJ</span>
            <div class="who">
              <span class="name">Mark Jones, Owner</span>
              <span class="firm">The Avalon Management Group &middot; Southern California</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212073104" aria-label="Play video testimonial — Ninder Chima-Jordan" style="background: url('/assets/testimonials/1212073104.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">The peer council</span>
          <blockquote>Of all the different groups we&rsquo;ve joined, this is the one where we&rsquo;ve gained the most significant learning. It accelerates our learning as a small business owner to be part of this group.</blockquote>
          <div class="attrib">
            <span class="initials">NC</span>
            <div class="who">
              <span class="name">Ninder Chima-Jordan</span>
              <span class="firm">Bayview Property Management &middot; California</span>
            </div>
          </div>
        </article>

        <article class="tcard" data-voice="senior-operator" data-topic="The peer council">
          <span class="kind">The peer council</span>
          <blockquote>Through Innovia, we&rsquo;ve been able to explore new opportunities, unlock cost efficiencies, and elevate our position in the marketplace with peer-driven collaboration while feeling part of a forward-thinking community; participation has been truly transformative.</blockquote>
          <div class="attrib">
            <span class="initials">JA</span>
            <div class="who">
              <span class="name">Jeffrey Annon, Vice President</span>
              <span class="firm">Southern States Management Group &middot; Florida</span>
            </div>
          </div>
        </article>

        <article class="tcard video long" data-voice="senior-operator" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212073105" aria-label="Play video testimonial — Paul Mengert, CEO" style="background: url('/assets/testimonials/1212073105.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">The peer council</span>
          <blockquote>Innovia brings together some of the finest minds in the association management industry across the United States. They work collaboratively to deliver the best results to their communities.</blockquote>
          <div class="attrib">
            <span class="initials">PM</span>
            <div class="who">
              <span class="name">Paul Mengert, CEO</span>
              <span class="firm">Association Management Group (AMG) &middot; North Carolina</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212073107" aria-label="Play video testimonial — Ben Klaus, Owner" style="background: url('/assets/testimonials/1212073107.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">The peer council</span>
          <blockquote>Typically I go to conferences and skip the sessions &mdash; I just want to talk to folks. At Innovia, the whole thing is talking to your peers. It&rsquo;s the best conference, and I&rsquo;ll be back next year.</blockquote>
          <div class="attrib">
            <span class="initials">BK</span>
            <div class="who">
              <span class="name">Ben Klaus, Owner</span>
              <span class="firm">Ascent Community Partners &middot; Colorado Springs, CO</span>
            </div>
          </div>
        </article>

        <article class="tcard" data-voice="cam-owner" data-topic="Business growth">
          <span class="kind">Business growth</span>
          <blockquote>I knew the &ldquo;big-box&rdquo; management companies were eventually going to be in my market, but as a member of Innovia we were prepared and remain competitive. We&rsquo;ve really benefited from the peer-to-peer networking opportunities to exchange experiences and ideas and collaborate with like-minded colleagues. Surrounding ourselves with a powerful network has better positioned us for future success.</blockquote>
          <div class="attrib">
            <span class="initials">RK</span>
            <div class="who">
              <span class="name">Robert Klages, Chief Executive Officer</span>
              <span class="firm">Community Property Management &middot; Missouri</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="Joining Innovia">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212074758" aria-label="Play video testimonial — Tyler Lendzion, CEO" style="background: url('/assets/testimonials/1212074758.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">Joining Innovia</span>
          <blockquote>My first year at the summit, and I&rsquo;m leaving with a list of about a hundred things I want to accomplish. The openness of the members here is tremendous.</blockquote>
          <div class="attrib">
            <span class="initials">TL</span>
            <div class="who">
              <span class="name">Tyler Lendzion, CEO</span>
              <span class="firm">Katonah Management Services &middot; Westchester, NY</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="senior-operator" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212073773" aria-label="Play video testimonial — Brian TerHark" style="background: url('/assets/testimonials/1212073773.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">The peer council</span>
          <blockquote>I&rsquo;ve always been passionate about the public perception of our industry. Being an Innovia member means collaborating with people who want to move the industry forward.</blockquote>
          <div class="attrib">
            <span class="initials">BT</span>
            <div class="who">
              <span class="name">Brian TerHark</span>
              <span class="firm">Westwind Management Group &middot; 10+ year member</span>
            </div>
          </div>
        </article>

        <article class="tcard" data-voice="senior-operator" data-topic="Joining Innovia">
          <span class="kind">Joining Innovia</span>
          <blockquote>If you are looking to keep your independent identity and values, stay competitive in the marketplace and be on top of new innovations in our industry &mdash; Innovia Co-op is the group for you.</blockquote>
          <div class="attrib">
            <span class="initials">JL</span>
            <div class="who">
              <span class="name">Jeffrey Luther, Vice President</span>
              <span class="firm">Vanguard Management Associates Inc. &middot; Maryland</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212074243" aria-label="Play video testimonial — Dana Hizkiya, Owner" style="background: url('/assets/testimonials/1212074243.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">The peer council</span>
          <blockquote>This is the best CEO gathering I&rsquo;ve been to since we started Next Generation. Hopefully we&rsquo;ll have many, many more years of it.</blockquote>
          <div class="attrib">
            <span class="initials">DH</span>
            <div class="who">
              <span class="name">Dana Hizkiya, Owner</span>
              <span class="firm">Next Generation Management &middot; Sunrise, FL</span>
            </div>
          </div>
        </article>

        <article class="tcard" data-voice="cam-owner" data-topic="Business growth">
          <span class="kind">Business growth</span>
          <blockquote>Innovia has truly inspired me to step out of my own way and build a bigger, better company. It has been an absolute pleasure to be part of this organization through which I have gained invaluable insights into how successful businesses grow. The business-to-business relationships formed through Innovia are one of the most valuable aspects for owners.</blockquote>
          <div class="attrib">
            <span class="initials">MC</span>
            <div class="who">
              <span class="name">Michael Carnahan, Owner &amp; Manager</span>
              <span class="firm">RedBrick Property Management &middot; Illinois</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="The peer council">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212074474" aria-label="Play video testimonial — Dave Reese" style="background: url('/assets/testimonials/1212074474.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">The peer council</span>
          <blockquote>We learn and share so we can produce better service for our clients &mdash; and bring better value to our management company and the associations we represent.</blockquote>
          <div class="attrib">
            <span class="initials">DR</span>
            <div class="who">
              <span class="name">Dave Reese</span>
              <span class="firm">Silvercreek Association Management &middot; Northern California</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="Joining Innovia">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212074593" aria-label="Play video testimonial — Ricky Zilem, Managing Partner" style="background: url('/assets/testimonials/1212074593.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">Joining Innovia</span>
          <blockquote>A proud member of Innovia. I really love the collaboration and the coming together to deliver a better product for our clients.</blockquote>
          <div class="attrib">
            <span class="initials">RZ</span>
            <div class="who">
              <span class="name">Ricky Zilem, Managing Partner</span>
              <span class="firm">P.S. Property Management Co. &middot; Austin, TX</span>
            </div>
          </div>
        </article>

        <article class="tcard video" data-voice="cam-owner" data-topic="Joining Innovia">
          <div class="vthumb" role="button" tabindex="0" data-vimeo="1212074826" aria-label="Play video testimonial — Ken Caskey" style="background: url('/assets/testimonials/1212074826.jpg') center / cover;">
            <span class="vbadge">Watch</span>
            <span class="vplay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          </div>
          <span class="kind">Joining Innovia</span>
          <blockquote>This is my first Innovia conference &mdash; and it certainly won&rsquo;t be my last. An amazing experience interacting with colleagues in our business, in a really interesting format. A+ all the way down.</blockquote>
          <div class="attrib">
            <span class="initials">KC</span>
            <div class="who">
              <span class="name">Ken Caskey</span>
              <span class="firm">First Coast Association Management &middot; Jacksonville, FL</span>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- MEMBER SPOTLIGHTS TEASER -->
  <section class="spotlights-teaser">
    <div class="container">
      <div class="head">
        <div>
          <div class="eyebrow on-dark"><span class="num" style="color: rgba(255,255,255,0.5)">No. 02</span><span class="rule-mini"></span>Member Spotlights</div>
          <h2 style="margin-top: 14px;">Members <em>in action.</em></h2>
        </div>
        <p>The cooperative grows by introduction &mdash; and once you&rsquo;re inside, the proof is the work. Thirty member companies, profiled &mdash; one for every stockholder in the cooperative, publishing through 2026.</p>
      </div>
      <div class="spotlight-grid">
        <a class="spotlight-card" href="/member-spotlights/">
          <span class="sp-tag">Nov 2025</span>
          <h4>Honoring excellence and innovation.</h4>
          <p>Nova Association Management Partners &middot; Core Value Awards</p>
        </a>
        <a class="spotlight-card" href="/member-spotlights/">
          <span class="sp-tag">Aug 2025</span>
          <h4>Twelve performance measures for an HOA&rsquo;s annual checkup.</h4>
          <p>Wise Property Solutions &middot; Practice</p>
        </a>
        <a class="spotlight-card" href="/member-spotlights/">
          <span class="sp-tag">Jul 2025</span>
          <h4>A remarkable example of leadership.</h4>
          <p>Great North Property Management &middot; Leadership</p>
        </a>
        <a class="spotlight-card spotlight-cta" href="/member-spotlights/">
          <span>See all member spotlights</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FOR BOARDS -->
  <section class="methodology">
    <div class="container">
      <div class="frame">
        <div>
          <div class="eyebrow"><span class="num">No. 03</span><span class="rule-mini"></span>For your communities</div>
          <h2>What the co-op means <em>for the communities you manage.</em></h2>
          <p>Joining Innovia doesn&rsquo;t change who you are to your boards &mdash; you keep your name, your local ownership, and the relationships you&rsquo;ve built. What changes is what stands behind you: the purchasing power, peer knowledge, and shared systems of 80+ independent operators, without becoming a national chain.</p>
          <p>When something hard comes up &mdash; a capital project, a vendor dispute, a governance question &mdash; you have a council of operators who have already solved it. That depth shows up in how your communities are served.</p>
        </div>
        <div class="rules">
          <div class="rule"><span class="k">01</span><span class="v">You stay locally owned and accountable to your boards &mdash; not to a corporate parent.</span></div>
          <div class="rule"><span class="k">02</span><span class="v">Vendor savings negotiated at cooperative scale flow to your communities, not to outside shareholders.</span></div>
          <div class="rule"><span class="k">03</span><span class="v">Hard problems have already been solved somewhere in the network &mdash; you can just ask.</span></div>
          <div class="rule"><span class="k">04</span><span class="v">Every quote on this page is real, named, and approved by the person who said it.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-finale">
    <div class="container">
      <div class="frame">
        <div>
          <div class="eyebrow" style="color: var(--innovia-navy); opacity: 0.65;"><span class="num" style="color: var(--innovia-navy);">No. 04</span><span class="rule-mini"></span>Share your voice</div>
          <h2>Members: <em>on the record</em> when you&rsquo;re ready.</h2>
          <p class="lead">If you&rsquo;re an Innovia member with something to say about how the co-op has affected your firm &mdash; for better or for worse &mdash; the council wants it on the record. Boards: read the quotes, then talk to the firms behind them.</p>
        </div>
        <div class="actions">
          <a href="/for-cams/why-innovia/#talk" class="btn btn-navy">
            For members &middot; Submit a quote
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </a>
          <a href="/find-a-management-company/" class="btn btn-outline">For boards &middot; Find the firm behind a quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  


  
`;
---
<BaseLayout
  title="Testimonials &amp; Member Voices · Innovia Co-op"
  description="Testimonials &amp; Member Voices · Innovia Co-op"
  ogImage="/assets/og/option-1-type-led.png"
  ctaLabel="Schedule a Conversation"
  ctaHref="/schedule-a-conversation/"
>
  <Fragment set:html={html} />
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Track header visual position in real time so the sticky filter
      // flows with the header slide-in/slide-out animation.
      var header = document.querySelector('.site-header');
      var filterSticky = document.querySelector('.filter-sticky');
      if (header && filterSticky) {
        (function sync() {
          filterSticky.style.top = Math.max(0, header.getBoundingClientRect().bottom) + 'px';
          requestAnimationFrame(sync);
        })();
      }

      // Filters
      var cards = Array.prototype.slice.call(document.querySelectorAll('.tcard'));
      var activeVoice = 'all';
      var activeTopic = 'all';

      function matches(card, voice, topic) {
        var voiceOk = voice === 'all' || card.dataset.voice === voice;
        var topicOk = topic === 'all' || card.dataset.topic === topic;
        return voiceOk && topicOk;
      }
      function countFor(voice, topic) {
        var n = 0;
        for (var i = 0; i < cards.length; i++) { if (matches(cards[i], voice, topic)) n++; }
        return n;
      }

      function applyFilters() {
        cards.forEach(function(card) {
          card.style.display = matches(card, activeVoice, activeTopic) ? '' : 'none';
        });
        // Gray out (disable) any pill that would return zero results given the
        // other group's current selection. The active pill is never disabled.
        document.querySelectorAll('[data-filter-group="voice"] .pill').forEach(function(p) {
          var empty = !p.classList.contains('active') && countFor(p.dataset.filter, activeTopic) === 0;
          p.classList.toggle('disabled', empty);
        });
        document.querySelectorAll('[data-filter-group="topic"] .pill').forEach(function(p) {
          var empty = !p.classList.contains('active') && countFor(activeVoice, p.dataset.filter) === 0;
          p.classList.toggle('disabled', empty);
        });
      }

      document.querySelectorAll('[data-filter-group="voice"] .pill').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (btn.classList.contains('disabled')) return;
          document.querySelectorAll('[data-filter-group="voice"] .pill').forEach(function(p) { p.classList.remove('active'); });
          btn.classList.add('active');
          activeVoice = btn.dataset.filter;
          applyFilters();
        });
      });

      document.querySelectorAll('[data-filter-group="topic"] .pill').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (btn.classList.contains('disabled')) return;
          document.querySelectorAll('[data-filter-group="topic"] .pill').forEach(function(p) { p.classList.remove('active'); });
          btn.classList.add('active');
          activeTopic = btn.dataset.filter;
          applyFilters();
        });
      });

      applyFilters();

      // Click-to-play in a modal lightbox. One reusable modal; the Vimeo iframe
      // is injected on open and cleared on close (which also stops playback).
      var modal = document.createElement('div');
      modal.className = 'v-modal';
      modal.setAttribute('aria-hidden', 'true');
      modal.innerHTML =
        '<div class="v-modal-backdrop"></div>' +
        '<div class="v-modal-dialog" role="dialog" aria-modal="true" aria-label="Video testimonial">' +
          '<button type="button" class="v-modal-close" aria-label="Close video">&times;</button>' +
          '<div class="v-modal-frame"></div>' +
        '</div>';
      document.body.appendChild(modal);
      var frameWrap = modal.querySelector('.v-modal-frame');
      var closeBtn  = modal.querySelector('.v-modal-close');
      var lastFocused = null;

      function openModal(id, label) {
        lastFocused = document.activeElement;
        var iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + id + '?autoplay=1&title=0&byline=0&portrait=0&dnt=1';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('title', label || 'Video testimonial');
        frameWrap.innerHTML = '';
        frameWrap.appendChild(iframe);
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        closeBtn.focus();
      }
      function closeModal() {
        if (!modal.classList.contains('open')) return;
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        frameWrap.innerHTML = '';           // unloads the player → stops audio/video
        document.body.style.overflow = '';
        if (lastFocused && lastFocused.focus) lastFocused.focus();
      }
      closeBtn.addEventListener('click', closeModal);
      modal.querySelector('.v-modal-backdrop').addEventListener('click', closeModal);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });

      document.querySelectorAll('.vthumb[data-vimeo]').forEach(function(thumb) {
        function open() { openModal(thumb.getAttribute('data-vimeo'), thumb.getAttribute('aria-label')); }
        thumb.addEventListener('click', open);
        thumb.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
        });
      });
    });
  </script>
</BaseLayout>
