---
// Member Highlight — video-led editorial member page (Innovia recruitment / board-facing).
// Data-driven: every string comes from src/data/member-highlights.ts, so a new member
// is a data change, not a markup change. Layout from the AGP design handoff
// (worked example: Avalon Management Group, San Diego & Riverside Counties).
//
// Chrome (header/footer) comes from BaseLayout — nothing bespoke here.
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/member-highlight.css";
import "../styles/member-highlight-page.css";
import type { MemberProfile, BenefitIcon, SealIcon } from "../data/member-highlights";

interface Props {
  member: MemberProfile;
}
const { member: m } = Astro.props;

// Inline SVG paths, keyed so the data file stays markup-free.
const BENEFIT_ICONS: Record<BenefitIcon, string> = {
  dollar:
    '<line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  message: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};

const SEAL_ICONS: Record<SealIcon, string> = {
  award: '<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  file: '<path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="m9 15 2 2 4-4"/>',
  badge:
    '<path d="M16 7a4 4 0 1 1-8 0"/><circle cx="12" cy="8" r="6"/><path d="M12 14v8"/><path d="M9 19h6"/>',
};

/** Wrap a provisional figure so unverified data is visible, not silent. */
const claim = (c: { text: string; confirm?: boolean }) =>
  c.confirm ? `${c.text} <span class="note">confirm</span>` : c.text;

const arrow =
  '<svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';

/** US 10-digit numbers to E.164 so the tel: link dials from any country. */
const telHref = (raw: string) => {
  const d = raw.replace(/[^0-9]/g, '');
  if (d.length === 10) return `tel:+1${d}`;
  if (d.length === 11 && d.startsWith('1')) return `tel:+${d}`;
  return `tel:${raw.replace(/[^0-9+]/g, '')}`;
};

/** Entities are fine in markup but not inside attributes. */
const plainTitle = m.video.title
  .replace(/&rsquo;/g, '\u2019')
  .replace(/&amp;/g, '&')
  .replace(/&mdash;/g, '\u2014');

// Directions link — query by address so it resolves even without coordinates.
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  [m.name, m.nap.streetAddress, `${m.nap.addressLocality}, ${m.nap.addressRegion} ${m.nap.postalCode}`]
    .filter(Boolean)
    .join(', ')
)}`;
---

{/* Per-member accent is set on <body> by the route (BaseLayout bodyStyle) —
    styles/member-highlight.css declares the default on `:root, body`, so a
    :root override here would lose to the body declaration. */}

<section class="v-hero" id="top">
  <div class="container">
    <div class="crumb-wrap">
      <nav class="mh-crumb" aria-label="Breadcrumb">
        <a href="/">Innovia</a><span aria-hidden="true">/</span>
        <a href="/member-spotlights/">Members</a><span aria-hidden="true">/</span>
        <span class="here" aria-current="page" set:html={m.name} />
        <span class="verified">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Verified Innovia Member
        </span>
      </nav>
    </div>

    <div class="v-hero-grid">
      <div class="v-hero-text">
        <div class="hero-badges">
          <span class="bdg">
            <img src="/assets/logos/innovia-white-green.png" alt="Innovia Co-op" width="72" height="17" loading="eager" decoding="async">
            <span>Member since <b>{m.memberSince}</b></span>
          </span>
          <span class="bdg"><span>Independently owned</span></span>
        </div>
        <h1 set:html={m.name} />
        <p class="region-tag" set:html={m.tagline} />
      </div>

      <div class="v-stage-wrap">
        {/* One stage, two states. The poster is always the first paint — when a
            video exists the stage becomes a button and the Vimeo player is only
            fetched on activation, so the hero never pays for a 3rd-party embed
            on load. */}
        <div
          class:list={[
            'v-stage',
            m.video.vimeoId ? 'is-playable' : 'is-pending',
            m.video.posterHasLowerThird && 'has-lower-third',
          ]}
          id={m.video.vimeoId ? 'videoStage' : undefined}
          data-vimeo={m.video.vimeoId ?? undefined}
          data-title={m.video.title}
          role={m.video.vimeoId ? 'button' : 'img'}
          tabindex={m.video.vimeoId ? '0' : undefined}
          aria-label={
            m.video.vimeoId
              ? `Play the member interview: ${plainTitle} (${m.video.runtime}). Opens in a player.`
              : `${m.video.posterAlt}. Member interview coming soon.`
          }
        >
          <div class="poster-slot">
            {/* Hero image and the likely LCP element — never lazy-load it.
                alt is empty because the wrapper carries its own label. */}
            {m.video.posterSrc && (
              <img
                src={m.video.posterSrc}
                alt=""
                width="1280"
                height="720"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              >
            )}
          </div>

          <span class="chip-tl">
            Member interview{!m.video.vimeoId && <Fragment> &middot; coming soon</Fragment>}
          </span>
          {m.video.filmedAt && <span class="corner-tag">{m.video.filmedAt}</span>}

          {m.video.vimeoId && (
            <div class="play" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          )}

          <div class:list={['caption', m.video.posterHasLowerThird && 'is-bare']}>
            {!m.video.posterHasLowerThird && (
              <Fragment>
                <div class={m.leader.photo ? 'av has-photo' : 'av'}>
                  {m.leader.photo
                    ? <img src={m.leader.photo} alt="" width="44" height="44" loading="lazy" decoding="async">
                    : m.leader.initials}
                </div>
                <div>
                  <div class="ttl" set:html={m.video.title} />
                  <div class="sub" set:html={m.video.subtitle} />
                </div>
              </Fragment>
            )}
            {m.video.vimeoId && m.video.runtime && <span class="runtime">{m.video.runtime}</span>}
          </div>
        </div>
      </div>
    </div>
  </div>

  {m.video.vimeoId && (
    <dialog class="v-modal" id="videoModal" aria-label={`${plainTitle} — member interview`}>
      <div class="v-modal-inner">
        <button type="button" class="v-modal-close" id="videoModalClose" aria-label="Close the video">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        <div class="v-modal-frame" id="videoModalFrame"></div>
      </div>
    </dialog>
  )}
</section>

<section class="v-substats tight" aria-label={`${m.name} at a glance`}>
  <div class="container">
    <div class="mh-stats">
      {m.stats.map((s) => (
        <div class="s">
          <span class="v">{s.value}</span>
          <span class="k">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="v-story" aria-labelledby="story-h">
  <div class="container">
    <div class="head">
      <p class="eyebrow on-accent"><span class="rule-mini"></span>The story</p>
      <h2 id="story-h" set:html={m.story.heading} />
    </div>
    <div class="body">
      <div class="col">
        {m.story.paragraphs.slice(0, 2).map((p, i) => (
          <p class={i === 0 ? 'drop' : undefined} set:html={p} />
        ))}
      </div>
      <div class="col">
        {m.story.paragraphs.slice(2).map((p) => <p set:html={p} />)}
      </div>
      <blockquote class="pull">
        <p set:html={m.story.pullQuote} />
      </blockquote>
    </div>
  </div>
</section>

<section class="v-coop" aria-labelledby="trust-h">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow on-accent"><span class="rule-mini"></span>Why boards trust {m.shortName ?? m.name}</p>
        <h2 id="trust-h" set:html={m.benefits.heading} />
      </div>
    </div>

    <div class="benefits">
      {m.benefits.items.map((b) => (
        <div class="b">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={BENEFIT_ICONS[b.icon]} />
          <h3 class="t" set:html={b.title} />
          <p class="d" set:html={claim(b.body)} />
        </div>
      ))}
    </div>

    <div class="changed">
      <h3 class="ch-head" set:html={m.coop.heading} />
      <p class="ch-sub" set:html={m.coop.sub} />
      <div class="ch-grid">
        {m.coop.points.map((p, i) => (
          <div class="ch">
            <span class="ix">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <span class="src" set:html={p.label} />
              <div class="t" set:html={claim(p.body)} />
            </div>
          </div>
        ))}
      </div>
      <p class="take" set:html={m.coop.takeaway} />
      <a class="ch-link" href="/for-cams/why-innovia/">
        See all membership benefits
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<section class="v-founder" aria-labelledby="leader-h">
  <div class="container">
    <div class="frame">
      <div class="card">
        <div class={m.leader.photo ? 'av has-photo' : 'av'} aria-hidden="true">
          {m.leader.photo
            ? <img src={m.leader.photo} alt="" width="220" height="220" loading="lazy" decoding="async">
            : m.leader.initials}
        </div>
        <p class="nm">{m.leader.name}</p>
        <p class="rl" set:html={m.leader.role} />
        <p class="creds">{m.leader.credentials.map((c) => <span>{c}</span>)}</p>
      </div>
      <div class="copy">
        <p class="eyebrow on-accent"><span class="rule-mini"></span>Leadership</p>
        <h2 id="leader-h" set:html={m.leader.heading} />
        {m.leader.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>

    <div class="accred">
      <div class="accred-head">
        <div>
          <p class="eyebrow on-accent"><span class="rule-mini"></span>Credentials &amp; standing</p>
          <h3>Credentialed at the firm, not just the desk.</h3>
        </div>
      </div>
      <div class="accred-grid">
        {m.accreditations.map((a) => (
          <div class={a.isInnovia ? 'cred is-innovia' : 'cred'}>
            <svg class="seal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SEAL_ICONS[a.seal]} />
            <p class="ac" set:html={a.abbr} />
            <p class="fn" set:html={a.full} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="v-comm" aria-labelledby="record-h">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow on-accent"><span class="rule-mini"></span>Track record</p>
        <h2 id="record-h" set:html={m.caseStudies.heading} />
      </div>
    </div>
    <div class="grid grid-2up">
      {m.caseStudies.items.map((c) => (
        <article class="cell">
          <p class="meta" set:html={c.meta} />
          <h3 class="nm" set:html={c.title} />
          <p class="cs-body" set:html={claim(c.body)} />
        </article>
      ))}
    </div>
  </div>
</section>

<section class="v-reviews" aria-labelledby="rep-h">
  <div class="container">
    <h2 id="rep-h" class="sr-only">Reputation</h2>
    <div class="rev-top">
      <div class="rev-brand">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
        <div class="gl">Reputation<small>Google rating</small></div>
      </div>
      {m.reviews.rating !== null && (
        <div class="rev-score">
          <span class="num">{m.reviews.rating}</span>
          <div class="meta">
            {/* Proportional fill — rounding 4.7 up to five solid stars overstates it. */}
            <div class="stars" role="img" aria-label={`${m.reviews.rating} out of 5 stars`}>
              <div class="row base" aria-hidden="true">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                ))}
              </div>
              <div
                class="row fill"
                aria-hidden="true"
                style={`width:${(Math.max(0, Math.min(5, m.reviews.rating ?? 0)) / 5) * 100}%`}
              >
                {[1, 2, 3, 4, 5].map(() => (
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                ))}
              </div>
            </div>
            <div class="count">
              {m.reviews.reviewCount
                ? `Based on ${m.reviews.reviewCount} Google reviews`
                : 'Google rating · review feed not yet connected'}
            </div>
          </div>
        </div>
      )}
    </div>
    {m.reviews.quotes.length > 0 ? (
      <div class="rev-grid">
        {m.reviews.quotes.map((q) => (
          <figure class="rcard">
            <div class="rstars" role="img" aria-label={`${q.stars} out of 5 stars`}>
              {Array.from({ length: q.stars }).map(() => (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              ))}
            </div>
            <blockquote><p set:html={`&ldquo;${q.text}&rdquo;`} /></blockquote>
            <figcaption>Google review</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="rev-grid">
        <div class="rcard rcard-pending"><p>Google reviews not yet connected.</p></div>
      </div>
    )}

    {m.reviews.placeUrl && (
      <a class="rev-all" href={m.reviews.placeUrl} target="_blank" rel="noopener noreferrer">
        {m.reviews.reviewCount
          ? `Read all ${m.reviews.reviewCount} reviews on Google`
          : 'Read the reviews on Google'}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    )}
  </div>
</section>

<section class="v-area" aria-labelledby="area-h">
  <div class="container">
    <div class="frame">
      <div class="map">
        <span class="label">Where they serve &middot; <span set:html={m.area.heading} /></span>
        <div
          id="member-map"
          class="map-canvas"
          data-center={`${m.area.center.lat},${m.area.center.lng}`}
          data-zoom={m.area.zoom}
          data-accent={m.accent}
          data-cities={JSON.stringify(m.area.cities)}
          data-hq={
            typeof m.nap.latitude === 'number' && typeof m.nap.longitude === 'number'
              ? JSON.stringify({
                  lat: m.nap.latitude,
                  lng: m.nap.longitude,
                  name: m.name,
                  street: m.nap.streetAddress,
                  city: `${m.nap.addressLocality}, ${m.nap.addressRegion} ${m.nap.postalCode}`,
                })
              : undefined
          }
          role="img"
          aria-label={`Map of the communities ${m.name} serves across ${m.area.heading.replace(/&amp;/g, 'and')}`}
        ></div>
        <noscript>
          <div class="map-ph">Service-area map &mdash; <span set:html={m.area.heading} /></div>
        </noscript>
      </div>
      <div class="coverage">
        <h2 id="area-h" set:html={m.area.heading} />
        <p set:html={m.area.blurb} />
        <div class="cities">
          {m.area.cities.map((c) => <span>{c.name}</span>)}
        </div>

        {m.nap.streetAddress && (
          <address class="office">
            <span class="lbl">Head office</span>
            <a class="addr" href={mapsHref} target="_blank" rel="noopener noreferrer">
              <span>{m.nap.streetAddress}</span>
              <span>{m.nap.addressLocality}, {m.nap.addressRegion} {m.nap.postalCode}</span>
              <span class="dir">
                Directions
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </span>
            </a>
            {m.nap.telephone && <a class="tel" href={telHref(m.nap.telephone)}>{m.nap.telephone}</a>}
            {m.hours && <p class="hrs" set:html={m.hours.display} />}
            {m.nap.url && (
              <a class="site" href={m.nap.url} target="_blank" rel="noopener noreferrer">
                {m.nap.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </a>
            )}
          </address>
        )}
      </div>
    </div>
  </div>
</section>

<section class="v-cta" id="cta" aria-labelledby="cta-h">
  <div class="container">
    <div class="frame">
      <div>
        <p class="eyebrow on-accent"><span class="rule-mini"></span>Talk to {m.shortName ?? m.name}</p>
        <h2 id="cta-h" set:html={m.cta.heading} />
        <p set:html={m.cta.body} />
      </div>
      <div class="actions">
        <a href={m.cta.href} class="btn btn-primary" set:html={`Request a Proposal${arrow}`} />
        <a href="/find-a-management-company/" class="btn btn-outline">Back to member directory</a>
      </div>
    </div>
  </div>
</section>
