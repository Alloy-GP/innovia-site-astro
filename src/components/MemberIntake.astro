---
// Member Profile Intake — Part 1 of member onboarding (self-saving intake form).
// Ported from the AGP design handoff (member-intake). Standalone chrome: logo-only
// header + Innovia×Alloy co-brand footer — no nav, nothing links off this page.
// Client-side only for now: autosave to localStorage + demo success state.
// TODO before launch: real file upload, server draft autosave, submit endpoint (see handoff).
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/member-intake.css";
---

  <!-- ============ HEADER (logo only — no nav, nothing links out) ============ -->
  <header class="site-header inverse">
    <div class="container row">
      <span class="brand"><img src="/assets/logos/innovia-white-green.png" alt="Innovia Co-op" style="height:38px;"></span>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="page-hero">
    <div class="container">
      <div class="crumb">
        <span>Innovia</span><span>/</span>
        <span>Members</span><span>/</span>
        <span style="color:#fff;">Profile Intake</span>
      </div>
      <div class="partflag">
        <span class="seg"><i class="on"></i><i class="on"></i></span>
        Part 1 of 2 · The basics
      </div>
      <h1>Build your <em>member profile.</em></h1>
      <p class="lede">Your profile is a public page that shows boards exactly why your firm belongs in the cooperative — and it starts working for you the moment it's live:</p>
      <ul class="hero-benefits">
        <li>
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span>
          <div><b>A link back to your site</b><small>A backlink from a trusted industry domain that strengthens your local SEO.</small></div>
        </li>
        <li>
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></span>
          <div><b>Seen by boards shopping firms</b><small>Featured in the directory boards browse when choosing a management company.</small></div>
        </li>
        <li>
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div><b>Co-op credibility</b><small>The Innovia stamp signals you're vetted and backed by a national network.</small></div>
        </li>
      </ul>
      <ol class="flow-timeline">
        <li class="step is-active">
          <span class="node">1</span>
          <div class="tx"><b>The basics</b><small>This form &middot; ~10 min</small></div>
        </li>
        <li class="step">
          <span class="node">2</span>
          <div class="tx"><b>A 30-minute call</b><small>We capture your story</small></div>
        </li>
        <li class="step">
          <span class="node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
          <div class="tx"><b>Your page goes live</b><small>Published to the directory</small></div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ INTAKE ============ -->
  <section class="intake" id="intake-form">
    <div class="container">
      <div class="grid">

        <!-- FORM -->
        <form class="lead-form" id="intakeForm" novalidate>
          <!-- Honeypot: hidden from users; if filled, the endpoint drops the submission as spam. -->
          <input type="text" name="company_url" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-body">
            <div class="form-head"><span class="form-label">Member profile · Part 1</span><span class="form-count">~10 min · saves as you go</span></div>

            <fieldset id="sec-firm" data-section="Your firm">
              <legend><span class="lx">01</span> Your firm</legend>
              <div class="grid-2">
                <input type="text" name="firm_name" placeholder="Company name (as it should appear)" aria-label="Company name" autocomplete="organization" data-key required>
                <input type="text" name="hq" placeholder="Headquarters (city, state)" aria-label="Headquarters" autocomplete="address-level2" data-key required>
              </div>
              <div class="grid-3">
                <input type="text" name="established" inputmode="numeric" placeholder="Year established" aria-label="Year established" data-key>
                <input type="text" name="member_since" inputmode="numeric" placeholder="Innovia member since (year)" aria-label="Innovia member since" data-key>
                <label class="field">Team size<select name="team_size" data-key><option value="">Select</option><option>1–10</option><option>11–25</option><option>26–50</option><option>51–100</option><option>100+</option></select></label>
              </div>
              <label class="field">Website<input type="url" name="website" placeholder="https://" aria-label="Website" autocomplete="url" data-key></label>
            </fieldset>

            <fieldset id="sec-contact" data-section="Primary contact">
              <legend><span class="lx">02</span> Primary contact</legend>
              <p class="hint">Who we'll coordinate the call with. This won't necessarily appear on your page.</p>
              <div class="grid-2">
                <input type="text" name="contact_name" placeholder="Full name" aria-label="Contact full name" autocomplete="name" data-key required>
                <input type="text" name="contact_role" placeholder="Role / title" aria-label="Role" autocomplete="organization-title" data-key required>
              </div>
              <div class="grid-2">
                <input type="email" name="contact_email" placeholder="Work email" aria-label="Work email" autocomplete="email" data-key required>
                <input type="tel" name="contact_phone" placeholder="Phone" aria-label="Phone" autocomplete="tel" data-key required>
              </div>
            </fieldset>

            <fieldset id="sec-brand" data-section="Your brand">
              <legend><span class="lx">03</span> Your brand</legend>
              <p class="hint">We lean into your own identity so your page doesn't feel like a template. A logo and one brand color is all we need to start.</p>
              <label class="logo-drop" id="logoDrop">
                <span class="prev" id="logoPrev">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </span>
                <span class="txt"><b>Upload your logo</b><small id="logoName">PNG or SVG preferred · transparent background if you have it</small></span>
                <input type="file" id="logoInput" accept="image/png,image/svg+xml,image/jpeg" aria-label="Upload logo">
              </label>
              <label class="field" style="margin-top:4px;">Brand color <span class="opt">Pick the closest, or set your exact hex</span></label>
              <div class="accent-pick" id="accentPick">
                <span class="sw" data-color="#C2531C" style="background:#C2531C;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="sw" data-color="#1F6FB2" style="background:#1F6FB2;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="sw" data-color="#1F8A5B" style="background:#1F8A5B;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="sw" data-color="#2C6E7F" style="background:#2C6E7F;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="sw" data-color="#7A4FB5" style="background:#7A4FB5;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="sw" data-color="#B23A48" style="background:#B23A48;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="sw" data-color="#B8862F" style="background:#B8862F;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="custom"><input type="color" id="accentCustom" value="#C2531C" aria-label="Custom brand color"> custom</span>
                <input type="hidden" name="brand_color" id="brandColor" value="" data-key>
              </div>
              <label class="field" style="margin-top:14px;">One-line descriptor <span class="opt">Optional</span><input type="text" name="tagline" placeholder="e.g. Boutique HOA management for the Valley of the Sun" aria-label="One-line descriptor" data-key></label>
            </fieldset>

            <fieldset id="sec-numbers" data-section="By the numbers">
              <legend><span class="lx">04</span> By the numbers</legend>
              <p class="hint">The figures that headline your page. Estimates are fine — we'll confirm on the call.</p>
              <div class="grid-2">
                <input type="text" name="communities" inputmode="numeric" placeholder="Communities / associations managed" aria-label="Communities managed" data-key>
                <input type="text" name="doors" inputmode="numeric" placeholder="Doors / units under management" aria-label="Doors under management" data-key>
              </div>
              <div class="grid-2">
                <input type="text" name="google_rating" inputmode="decimal" placeholder="Google rating (e.g. 4.9)" aria-label="Google rating" data-key>
                <input type="url" name="google_url" placeholder="Google Business / reviews link" aria-label="Google reviews link" data-key>
              </div>
            </fieldset>

            <fieldset id="sec-coop" data-section="Your Innovia membership">
              <legend><span class="lx">05</span> Your Innovia membership</legend>
              <p class="hint">This is the heart of your page — what membership actually does for your firm. Estimates are fine; we'll confirm on the call.</p>
              <label class="field">Co-op programs &amp; partners you use <span class="opt">Select all that apply</span></label>
              <div class="chips">
                <label><input type="checkbox" name="coop_prog" value="First Citizens Bank"><span>First Citizens Bank</span></label>
                <label><input type="checkbox" name="coop_prog" value="Alloy / CAM Growth"><span>Alloy &middot; CAM Growth</span></label>
                <label><input type="checkbox" name="coop_prog" value="Preferred vendors"><span>Preferred vendor pricing</span></label>
                <label><input type="checkbox" name="coop_prog" value="Peer network"><span>Peer owner network</span></label>
                <label><input type="checkbox" name="coop_prog" value="Benchmarking"><span>Benchmarking data</span></label>
                <label><input type="checkbox" name="coop_prog" value="Education"><span>Education / best practices</span></label>
              </div>
              <div class="grid-2">
                <input type="text" name="vendor_savings" placeholder="Est. vendor savings (e.g. 22%)" aria-label="Vendor savings" data-key>
                <input type="text" name="dollars_saved" placeholder="Annual $ saved / rebated (e.g. $340k)" aria-label="Dollars saved or rebated" data-key>
              </div>
              <label class="field">How membership has helped your firm <span class="opt">Optional</span><textarea name="coop_impact" rows="2" placeholder="e.g. Co-op banking and vendor pricing let us bid sharper and protect margin — while staying independent." aria-label="How membership helped" data-key></textarea></label>
            </fieldset>

            <fieldset id="sec-area" data-section="Service area">
              <legend><span class="lx">06</span> Where you work</legend>
              <p class="hint">Your service area is part of what makes your page distinct. The more specific, the better the map.</p>
              <div class="grid-2">
                <input type="text" name="states" placeholder="State(s) — e.g. AZ" aria-label="States" data-key required>
                <input type="text" name="region" placeholder="Region / metro — e.g. Greater Phoenix" aria-label="Region" data-key>
              </div>
              <label class="field">Cities &amp; communities you cover<textarea name="cities" rows="2" placeholder="Phoenix, Scottsdale, Tempe, Mesa, Chandler, Gilbert…" aria-label="Cities served" data-key></textarea></label>
            </fieldset>

            <fieldset id="sec-leadership" data-section="Leadership">
              <legend><span class="lx">07</span> Leadership</legend>
              <p class="hint">The face of the firm — and likely the person we'll feature in your interview.</p>
              <div class="grid-2">
                <input type="text" name="founder_name" placeholder="Founder / principal name" aria-label="Founder name" data-key>
                <input type="text" name="founder_role" placeholder="Title — e.g. Founder & President" aria-label="Founder title" data-key>
              </div>
              <label class="field">Personal credentials <span class="opt">Select all that apply</span></label>
              <div class="chips">
                <label><input type="checkbox" name="cred" value="CMCA"><span>CMCA</span></label>
                <label><input type="checkbox" name="cred" value="AMS"><span>AMS</span></label>
                <label><input type="checkbox" name="cred" value="PCAM"><span>PCAM</span></label>
                <label><input type="checkbox" name="cred" value="LSM"><span>LSM</span></label>
                <label><input type="checkbox" name="cred" value="RS"><span>RS</span></label>
                <label><input type="checkbox" name="cred" value="CMCA-pursuing"><span>In progress</span></label>
              </div>
              <div class="grid-2" style="margin-top:14px;">
                <input type="text" name="founder_board" placeholder="Industry involvement (e.g. CAI AZ chapter board)" aria-label="Industry involvement" data-key>
                <input type="text" name="founder_coop_role" placeholder="Role at the co-op (e.g. vendor council)" aria-label="Co-op role" data-key>
              </div>
            </fieldset>

            <fieldset id="sec-accred" data-section="Accreditations">
              <legend><span class="lx">08</span> Firm accreditations <span class="opt-tag">optional</span></legend>
              <div class="chips">
                <label><input type="checkbox" name="accred" value="AAMC"><span>AAMC</span></label>
                <label><input type="checkbox" name="accred" value="CAI"><span>CAI member</span></label>
                <label><input type="checkbox" name="accred" value="Licensed"><span>Licensed &amp; bonded</span></label>
                <label><input type="checkbox" name="accred" value="Insured"><span>Insured</span></label>
                <label><input type="checkbox" name="accred" value="IREM"><span>IREM</span></label>
              </div>
              <label class="field" style="margin-top:14px;">CAI chapter / licensing state <span class="opt">Optional</span><input type="text" name="accred_detail" placeholder="e.g. CAI Arizona Chapter · Licensed in AZ" aria-label="Accreditation detail" data-key></label>
            </fieldset>

            <fieldset id="sec-communities" data-section="Notable communities">
              <legend><span class="lx">09</span> Notable communities <span class="opt-tag">a few highlights</span></legend>
              <p class="hint">Two or three communities you're proud to manage. These appear as a roster on your page.</p>
              <div class="comm-rows" id="commRows">
                <div class="comm-row">
                  <input type="text" name="comm_name" placeholder="Community name" aria-label="Community name" data-key>
                  <input type="text" name="comm_city" placeholder="City" aria-label="Community city">
                  <input type="text" name="comm_doors" inputmode="numeric" placeholder="Doors" aria-label="Community doors">
                  <input type="text" name="comm_type" placeholder="Type (HOA, condo…)" aria-label="Community type">
                  <button type="button" class="rm" aria-label="Remove row"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
                </div>
              </div>
              <button type="button" class="add-row" id="addComm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>Add another community</button>
            </fieldset>

            <fieldset id="sec-words" data-section="In your words">
              <legend><span class="lx">10</span> In your words <span class="opt-tag">optional</span></legend>
              <p class="hint">Don't overthink these — a rough draft is perfect. They become the headline quotes on your page, and we'll refine them together on the call.</p>
              <label class="field">In one line, why did you join Innovia?<textarea name="why_joined" rows="2" placeholder="e.g. The co-op gave us a national's muscle — without making us sell our company to get it." aria-label="Why you joined" data-key></textarea></label>
              <label class="field">Why do you love being a member?<textarea name="why_love" rows="2" placeholder="e.g. We stay independent while having the buying power and thought leadership of the best firms in the country." aria-label="Why you love it" data-key></textarea></label>
            </fieldset>

            <fieldset id="sec-video" data-section="Your interview">
              <legend><span class="lx">11</span> Your interview video</legend>
              <p class="hint">The interview is the centerpiece of your page. No need to prepare anything now — this just tells us where you're starting from so we can plan the call.</p>
              <label class="field">Do you have video footage we could use?</label>
              <div class="radio-row">
                <label><input type="radio" name="video_status" value="have-ready" data-key>Yes — we have polished footage ready to share</label>
                <label><input type="radio" name="video_status" value="have-raw" data-key>We have some raw footage / clips</label>
                <label><input type="radio" name="video_status" value="willing">No, but we're willing to record an interview</label>
                <label><input type="radio" name="video_status" value="unsure">Not sure yet — let's discuss on the call</label>
              </div>
              <label class="field" style="margin-top:14px;">Who should we feature? <span class="opt">Optional</span><input type="text" name="spokesperson" placeholder="Name & role of your preferred spokesperson" aria-label="Spokesperson" data-key></label>
            </fieldset>

            <div class="submit-row">
              <small>Confidential. Your details stay inside the cooperative office — we don't share with vendors or sell. You can come back and finish later; this form saves as you go.</small>
              <div class="row-actions">
                <button type="button" class="btn-clear" id="clearForm">Clear form</button>
                <button type="submit">Submit &amp; book the call
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
                </button>
              </div>
            </div>
            <p class="form-error" id="intakeError" role="alert" hidden>Something went wrong sending your profile. Please try again, or email <a href="mailto:hello@innoviaco-op.com">hello@innoviaco-op.com</a>.</p>
          </div>

          <!-- success state -->
          <div class="done-state">
            <div class="seal"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
            <h3>Part 1 is in. Nicely done.</h3>
            <p>We've got your basics. Someone from the cooperative office will reach out within two business days to schedule your 30-minute call — that's where we'll capture your story, shape the interview, and fill in the rest.</p>
            <p>Keep an eye on the inbox you gave us. If anything changes in the meantime, just reply to that email.</p>
            <div class="nextline">Next · Part 2 of 2 — the conversation</div>
          </div>
        </form>

        <!-- RAIL -->
        <aside class="rail">
          <div class="card progress-card">
            <div class="ptop"><span class="lbl">Your progress</span><span class="pct" id="pctLabel">0%</span></div>
            <div class="track"><div class="fill" id="pctFill"></div></div>
            <div class="savenote"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>Saved automatically on this device</div>
            <ul class="navlist" id="navList">
              <li data-for="sec-firm"><a href="#sec-firm"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Your firm</a></li>
              <li data-for="sec-contact"><a href="#sec-contact"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Primary contact</a></li>
              <li data-for="sec-brand"><a href="#sec-brand"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Your brand</a></li>
              <li data-for="sec-numbers"><a href="#sec-numbers"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>By the numbers</a></li>
              <li data-for="sec-coop"><a href="#sec-coop"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Your Innovia membership</a></li>
              <li data-for="sec-area"><a href="#sec-area"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Where you work</a></li>
              <li data-for="sec-leadership"><a href="#sec-leadership"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Leadership</a></li>
              <li data-for="sec-communities"><a href="#sec-communities"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Communities</a></li>
              <li data-for="sec-words"><a href="#sec-words"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>In your words</a></li>
              <li data-for="sec-video"><a href="#sec-video"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Your interview</a></li>
            </ul>
          </div>

          <div class="card call-card">
            <h4>What the 30-minute call covers</h4>
            <div class="ck">Part 2 of 2 · we lead it</div>
            <ul>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>Your origin story, in your own words</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>Why you joined Innovia — and what changed</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>The angle and tone for your interview video</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>Board or homeowner voices worth quoting</li>
            </ul>
            <div class="foot">Finishing this form puts your profile in the queue for publishing. We work through completed profiles first.</div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ============ FOOTER (Innovia × Alloy co-brand) ============ -->
  <footer class="site-footer">
    <div class="container">
      <div class="brand brand-center">
        <div class="foot-logos">
          <span class="foot-innovia"><img src="/assets/logos/innovia-white-green.png" alt="Innovia Co-op"></span>
          <span class="foot-div"></span>
          <span class="foot-alloy"><img src="/assets/logos/alloy-inverted.svg" alt="Alloy"></span>
        </div>
        <p>Brought together by Innovia and Alloy, working in collaboration to give every member firm a profile that shows boards exactly why they belong in the cooperative.</p>
      </div>
      <div class="copy">
        <span>&copy; 2026 Innovia Co-op. Member-owned.</span>
        <span class="colophon">We stand apart because we stand together.</span>
      </div>
    </div>
  </footer>

<script is:inline>
  (function(){
    var form = document.getElementById('intakeForm');
    var STORAGE_KEY = 'innovia_member_intake_v1';

    /* ---------- Accent color picker ---------- */
    var swatches = document.querySelectorAll('#accentPick .sw');
    var customInput = document.getElementById('accentCustom');
    var brandHidden = document.getElementById('brandColor');
    function selectAccent(color, fromCustom){
      brandHidden.value = color;
      swatches.forEach(function(s){ s.classList.toggle('sel', s.dataset.color.toLowerCase() === color.toLowerCase()); });
      if(!fromCustom){ try{ customInput.value = color; }catch(e){} }
      save();
      updateProgress();
    }
    swatches.forEach(function(s){ s.addEventListener('click', function(){ selectAccent(s.dataset.color, false); }); });
    customInput.addEventListener('input', function(){ selectAccent(customInput.value, true); });

    /* ---------- Logo preview ---------- */
    var logoInput = document.getElementById('logoInput');
    var logoPrev = document.getElementById('logoPrev');
    var logoName = document.getElementById('logoName');
    logoInput.addEventListener('change', function(){
      var f = logoInput.files && logoInput.files[0];
      if(!f) return;
      logoName.textContent = f.name;
      var reader = new FileReader();
      reader.onload = function(e){ logoPrev.innerHTML = '<img src="'+e.target.result+'" alt="logo preview">'; };
      reader.readAsDataURL(f);
      updateProgress();
    });

    /* ---------- Repeatable community rows ---------- */
    var commRows = document.getElementById('commRows');
    document.getElementById('addComm').addEventListener('click', function(){
      if(commRows.children.length >= 5) return;
      var first = commRows.children[0];
      var clone = first.cloneNode(true);
      clone.querySelectorAll('input').forEach(function(i){ i.value=''; });
      commRows.appendChild(clone);
      bindRemove(clone);
      bindInputs(clone);
    });
    function bindRemove(row){
      var btn = row.querySelector('.rm');
      btn.addEventListener('click', function(){
        if(commRows.children.length > 1){ row.remove(); }
        else { row.querySelectorAll('input').forEach(function(i){ i.value=''; }); }
        save(); updateProgress();
      });
    }
    function bindInputs(scope){
      scope.querySelectorAll('input,select,textarea').forEach(function(el){
        var ev = (el.type==='checkbox'||el.type==='radio') ? 'change' : 'input';
        el.addEventListener(ev, function(){ save(); updateProgress(); });
      });
    }
    bindRemove(commRows.children[0]);

    /* ---------- Progress ---------- */
    var keyFields = Array.from(form.querySelectorAll('[data-key]'));
    var pctFill = document.getElementById('pctFill');
    var pctLabel = document.getElementById('pctLabel');
    function fieldFilled(el){
      if(el.type==='radio'){ return !!form.querySelector('input[name="'+el.name+'"]:checked'); }
      if(el.type==='checkbox'){ return el.checked; }
      return el.value && el.value.trim().length>0;
    }
    function updateProgress(){
      // de-dupe radio groups
      var seen = {}; var total=0, filled=0;
      keyFields.forEach(function(el){
        if(el.type==='radio'){ if(seen[el.name]) return; seen[el.name]=1; }
        total++;
        if(fieldFilled(el)) filled++;
      });
      // logo counts as a field too
      total++; if(logoInput.files && logoInput.files.length) filled++;
      var pct = Math.round((filled/total)*100);
      pctFill.style.width = pct+'%';
      pctLabel.textContent = pct+'%';
      // section completion dots
      document.querySelectorAll('#navList li').forEach(function(li){
        var sec = document.getElementById(li.dataset.for);
        if(!sec) return;
        var reqd = sec.querySelectorAll('[required]');
        var ok;
        if(reqd.length){ ok = Array.from(reqd).every(fieldFilled); }
        else {
          var any = sec.querySelectorAll('[data-key], input[type=checkbox], input[type=radio]');
          ok = Array.from(any).some(fieldFilled) || (li.dataset.for==='sec-brand' && logoInput.files && logoInput.files.length);
        }
        li.classList.toggle('done', !!ok);
      });
    }

    /* ---------- Persistence ---------- */
    function save(){
      try{
        var data = {};
        form.querySelectorAll('input,select,textarea').forEach(function(el,i){
          if(el.type==='file') return;
          var k = el.name || el.id;
          if(!k) return;
          if(el.type==='checkbox'){ data['cb_'+k+'_'+el.value] = el.checked; }
          else if(el.type==='radio'){ if(el.checked) data['r_'+k]=el.value; }
          else { data['v_'+k+'_'+i] = el.value; }
        });
        data._commCount = commRows.children.length;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      }catch(e){}
    }
    function restore(){
      var raw; try{ raw = localStorage.getItem(STORAGE_KEY); }catch(e){ return; }
      if(!raw) return;
      var data; try{ data = JSON.parse(raw); }catch(e){ return; }
      // rebuild extra community rows first
      var want = data._commCount || 1;
      while(commRows.children.length < want){ document.getElementById('addComm').click(); }
      form.querySelectorAll('input,select,textarea').forEach(function(el,i){
        if(el.type==='file') return;
        var k = el.name || el.id;
        if(!k) return;
        if(el.type==='checkbox'){ if('cb_'+k+'_'+el.value in data) el.checked = data['cb_'+k+'_'+el.value]; }
        else if(el.type==='radio'){ if(data['r_'+k]===el.value) el.checked = true; }
        else { var key='v_'+k+'_'+i; if(key in data) el.value = data[key]; }
      });
      if(brandHidden.value){ selectAccent(brandHidden.value, false); }
    }

    /* ---------- Bind + init ---------- */
    bindInputs(form);
    restore();
    updateProgress();

    /* ---------- Submit ---------- */
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var firstInvalid = null;
      form.querySelectorAll('[required]').forEach(function(el){
        if(!fieldFilled(el)){ el.style.borderColor = 'var(--danger)'; if(!firstInvalid) firstInvalid = el; }
        else { el.style.borderColor = ''; }
      });
      if(firstInvalid){ firstInvalid.focus(); return; }

      var btn = form.querySelector('button[type=submit]');
      var btnHtml = btn ? btn.innerHTML : '';
      var errEl = document.getElementById('intakeError');
      if(errEl){ errEl.hidden = true; }
      if(btn){ btn.disabled = true; btn.textContent = 'Sending…'; }

      fetch('/api/member-intake/', { method: 'POST', body: new FormData(form) })
        .then(function(r){ if(!r.ok) throw new Error('HTTP ' + r.status); return r; })
        .then(function(){
          form.classList.add('is-done');
          try{ localStorage.removeItem(STORAGE_KEY); }catch(e){}
          window.scrollTo({ top: form.getBoundingClientRect().top + window.scrollY - 120, behavior: 'smooth' });
        })
        .catch(function(){
          if(btn){ btn.disabled = false; btn.innerHTML = btnHtml; }
          if(errEl){ errEl.hidden = false; errEl.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        });
    });

    /* ---------- Clear form ---------- */
    var clearBtn = document.getElementById('clearForm');
    if(clearBtn){
      clearBtn.addEventListener('click', function(){
        if(!confirm('Clear all fields and your saved draft? This can’t be undone.')) return;
        try{ localStorage.removeItem(STORAGE_KEY); }catch(e){}
        location.reload();
      });
    }
  })();

</script>
